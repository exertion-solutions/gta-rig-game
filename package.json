{
  "name": "gta-rig-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-assets.mjs && node scripts/gen-voice.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/check-assets.mjs && node scripts/gen-voice.mjs --if-missing",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-assets": "node scripts/sync-assets.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "gen-voice": "node scripts/gen-voice.mjs",
    "test:e2e": "playwright test",
    "build:pages": "npm run build -- --base=/gta-rig-game/",
    "extract-traversal": "node scripts/extract-traversal.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "postprocessing": "^6.39.6",
    "r3f-perf": "^7.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "meshoptimizer": "^1.1.1",
    "phaser": "^4.2.1",
    "playcanvas": "^2.24.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
